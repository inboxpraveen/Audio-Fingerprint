# Copy this file to .env and change what you need. Every value is optional.
# The full list is in docs/CONFIGURATION.md, or run `audiofp config --describe`.

# ---- profile & server ------------------------------------------------------
AUDIOFP_PROFILE=development          # development | production | testing
AUDIOFP_HOST=127.0.0.1               # 0.0.0.0 to expose on the network
AUDIOFP_PORT=5000
AUDIOFP_DATA_DIR=data                # database, uploads, logs, job history

# ---- security ----------------------------------------------------------------
# Require an API key on every /api/v1 request (the UI will ask for it once).
# AUDIOFP_API_KEY=change-me
# Folders the server may index via POST /tracks/index-directory (comma-separated).
# Required in production; unset = any path in development.
# AUDIOFP_INDEX_ROOTS=/srv/recordings,/mnt/archive
# AUDIOFP_ALLOW_DIRECTORY_INDEXING=true
# AUDIOFP_CORS_ORIGINS=https://qa.example.com
# AUDIOFP_TRUST_PROXY=false            # true when behind nginx/traefik

# ---- storage -----------------------------------------------------------------
AUDIOFP_STORAGE_TYPE=sqlite          # memory | sqlite | postgres
# AUDIOFP_SQLITE_PATH=data/fingerprints.db
# AUDIOFP_POSTGRES_DSN=postgresql://audiofp:secret@localhost:5432/audiofp
# AUDIOFP_FINGERPRINT_COMPAT=strict  # strict | warn | ignore  (parameter mismatch with an existing DB)

# ---- uploads & indexing ------------------------------------------------------
AUDIOFP_MAX_UPLOAD_MB=2048
AUDIOFP_DEDUPE=content               # content | path | none
AUDIOFP_INDEX_WORKERS=0              # 0 = min(4, CPU count)
AUDIOFP_MAX_CONCURRENT_JOBS=2
AUDIOFP_KEEP_FAILED_UPLOADS=false

# ---- matching defaults (also adjustable per request and in the UI) ----------
AUDIOFP_TOP_K=5
AUDIOFP_MIN_ALIGNED_HASHES=10
AUDIOFP_MIN_CONFIDENCE=0.02
AUDIOFP_MIN_PEAK_RATIO=12
AUDIOFP_MAX_QUERY_SECONDS=3600

# ---- fingerprint parameters (changing any of these means re-indexing) -------
# AUDIOFP_SAMPLE_RATE=11025
# AUDIOFP_N_FFT=2048
# AUDIOFP_HOP_LENGTH=512
# AUDIOFP_PEAK_NEIGHBORHOOD_SIZE=20
# AUDIOFP_MIN_AMPLITUDE=10
# AUDIOFP_FAN_VALUE=10
# AUDIOFP_MAX_HASH_TIME_DELTA=200

# ---- logging -----------------------------------------------------------------
AUDIOFP_LOG_LEVEL=INFO               # DEBUG | INFO | WARNING | ERROR
AUDIOFP_LOG_FORMAT=text              # text | json
# AUDIOFP_LOG_FILE=auto               # auto: <data_dir>/logs/audiofp.log in production, console only elsewhere. none: console only
